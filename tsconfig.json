{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["apps/**/*.ts", "packages/**/*.ts"],
  // apps/web 是浏览器代码，需要 DOM lib，由其自身 tsconfig 单独类型检查
  // （见根脚本 web:typecheck）。DOM lib 会把全局 ReadableStream 覆盖为
  // 非 async-iterable，破坏 Node 侧包，故不在此根配置中纳入 apps/web。
  "exclude": ["apps/web"]
}
