.page { min-height: 100vh; padding: 24rpx; box-sizing: border-box; background: #f7f8fa; }
.card { padding: 24rpx; border-radius: 16rpx; background: #fff; box-shadow: 0 4rpx 18rpx rgba(0, 0, 0, .05); }
.config-card .input { margin-bottom: 16rpx; }
.input { min-height: 72rpx; padding: 0 20rpx; box-sizing: border-box; border: 1rpx solid #dfe3e8; border-radius: 10rpx; background: #fff; }
.messages { height: 760rpx; margin: 24rpx 0; }
.message { max-width: 84%; margin: 16rpx 0; padding: 18rpx 22rpx; border-radius: 14rpx; line-height: 1.6; word-break: break-word; }
.message.user { margin-left: auto; color: #fff; background: #1677ff; }
.message.assistant { margin-right: auto; background: #fff; }
.error { margin: 16rpx 0; padding: 16rpx; color: #b42318; background: #fff0ed; border-radius: 10rpx; }
.composer { display: flex; flex-wrap: wrap; gap: 12rpx; padding: 16rpx; background: #fff; border-radius: 16rpx; }
.composer-input { flex: 1 1 100%; width: 100%; }
.composer button { flex: 1 1 0; min-width: 0; }
