FROM node:22-alpine AS web
WORKDIR /app
COPY . .
RUN npm ci --ignore-scripts
RUN npm run build --workspace @trpg-rule-agent/web-next

FROM python:3.12-slim
WORKDIR /app
ENV PYTHONUNBUFFERED=1
ENV TRPG_HOST=0.0.0.0
COPY services/retrieval-python services/retrieval-python
COPY services/app-python services/app-python
RUN python -m pip install --no-cache-dir services/retrieval-python services/app-python \
    && python -m pip install --no-cache-dir -r services/retrieval-python/requirements-vector.txt
COPY --from=web /app/apps/web-next/dist apps/web-next/dist
COPY config config
RUN cp config/app.example.yaml config/app.yaml
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=3)"]
CMD ["trpg-app"]
