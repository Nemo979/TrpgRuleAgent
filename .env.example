# 模型 Provider，首版只支持 openai-compatible（OpenAI Chat Completions 协议）
LLM_PROVIDER=openai-compatible
LLM_MODEL=your-model-id
LLM_BASE_URL=https://your-provider.example/v1
LLM_API_KEY=replace-me
LLM_CONTEXT_WINDOW=128000
LLM_MAX_TOKENS=8192
LLM_REASONING=false
RETRIEVAL_BASE_URL=http://127.0.0.1:8765
RULESET_ID=pathfinder-1e

# BYOK Agent Gateway（npm run gateway）
# 注意：Gateway 不读取 LLM_API_KEY / LLM_MODEL / LLM_BASE_URL——
# 模型连接配置由客户端在创建会话时提交（BYOK 自定义模型），
# 模型 Key 由前端每次请求通过 X-Model-Api-Key 头携带
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8787
GATEWAY_SESSION_TTL_MS=1800000
# 单进程来源限流：窗口内请求数；生产多实例建议在反向代理层做共享限流
GATEWAY_RATE_LIMIT_MAX_REQUESTS=120
GATEWAY_RATE_LIMIT_WINDOW_MS=60000
# CORS Origin 白名单（逗号分隔），为空则不允许任何跨域来源
# Web 前端注意：若前端与 Gateway 不同源（如开发期 Vite dev server 在
# http://localhost:5173，而 Gateway 在 127.0.0.1:8787），需把前端源加入此处，
# Gateway 才会回显该 Origin 允许跨域访问：
#   GATEWAY_ALLOWED_ORIGINS=http://localhost:5173
# 生产环境建议改为同源反向代理（把 /v1/* 与 /health 反代到 Gateway，
# Web 静态资源与 API 同源），此时 baseUrl 用空串即可，无需 CORS，也避免凭据跨域。
GATEWAY_ALLOWED_ORIGINS=
# 模型 Base URL 前缀白名单（逗号分隔，如 https://api.openai.com/v1）
# 按 origin + 路径边界匹配：/v1 命中 /v1、/v1/chat，不命中 /v1x 或 /admin
GATEWAY_MODEL_BASE_URL_ALLOWLIST=
# 本地开发开关：允许 http://localhost / 127.0.0.1 模型端点（默认关闭）
GATEWAY_ALLOW_LOCALHOST_MODEL=false
# 允许客户端选择的规则集（逗号分隔）；为空则只允许 RULESET_ID 指定的默认规则集
GATEWAY_ALLOWED_RULESETS=
