{
  "name": "trpg-rule-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup:pf": "bash scripts/setup-pf.sh",
    "start": "bash scripts/start.sh",
    "check": "tsc --noEmit && npm run web:typecheck && npm run test && npm run web:build",
    "test": "vitest run",
    "web:typecheck": "tsc --noEmit -p apps/web/tsconfig.json",
    "web:dev": "npm run dev --workspace @trpg-rule-agent/web",
    "web:build": "npm run build --workspace @trpg-rule-agent/web",
    "web:preview": "npm run preview --workspace @trpg-rule-agent/web",
    "next:web:dev": "npm run dev --workspace @trpg-rule-agent/web-next",
    "next:web:build": "npm run build --workspace @trpg-rule-agent/web-next",
    "next:server": "bash scripts/start-next.sh",
    "next:test:python": "PYTHONPATH=services/app-python/src:services/retrieval-python/src .venv312/bin/python -m unittest discover -s services/app-python/tests -v",
    "next:eval:embedding": "bash scripts/benchmark-embedding.sh",
    "test:python": "PYTHONPATH=services/retrieval-python/src python3 -m unittest discover -s services/retrieval-python/tests -v",
    "rules:import:pf-chm": "bash scripts/import-pf-chm.sh",
    "rules:import:pf": "PYTHONPATH=services/retrieval-python/src python3 -m trpg_retrieval.importers.chm --extracted data/pathfinder-1e/extracted --output data/pathfinder-1e/generated/documents.jsonl --report data/pathfinder-1e/generated/import-report.json",
    "vector:install": ".venv/bin/python -m pip install -r services/retrieval-python/requirements-vector.txt",
    "vector:build:pf": "PYTHONPATH=services/retrieval-python/src .venv/bin/python -m trpg_retrieval.vector_index --documents data/pathfinder-1e/generated/documents.jsonl --index-dir data/pathfinder-1e/vector-index-fastembed --cache-dir data/fastembed-cache",
    "eval:retrieval:pf": "PYTHONPATH=services/retrieval-python/src .venv312/bin/python -m trpg_retrieval.evaluation --documents data/libraries/pathfinder-1e/current/documents.jsonl --index-dir data/libraries/pathfinder-1e/current/vector-index --cases rulepacks/pathfinder-1e/evals/retrieval.jsonl --report data/pathfinder-1e/generated/retrieval-eval.json",
    "eval:retrieval:pf:structured": "PYTHONPATH=services/retrieval-python/src .venv312/bin/python -m trpg_retrieval.evaluation --documents data/libraries/pathfinder-1e/current/documents.jsonl --index-dir data/libraries/pathfinder-1e/current/vector-index --cases rulepacks/pathfinder-1e/evals/structured-retrieval.jsonl --report data/pathfinder-1e/generated/structured-retrieval-eval.json",
    "eval:retrieval:pf:vector": "PYTHONPATH=services/retrieval-python/src .venv312/bin/python -m trpg_retrieval.evaluation --documents data/libraries/pathfinder-1e/current/documents.jsonl --index-dir data/libraries/pathfinder-1e/current/vector-index --cases rulepacks/pathfinder-1e/evals/retrieval.jsonl --backend chroma --report data/pathfinder-1e/generated/retrieval-eval-vector.json",
    "eval:answer:pf": "PYTHONPATH=services/app-python/src:services/retrieval-python/src .venv312/bin/python -m trpg_app.answer_evaluation --config config/app.yaml --documents data/libraries/pathfinder-1e/current/documents.jsonl --index-dir data/libraries/pathfinder-1e/current/vector-index --cases rulepacks/pathfinder-1e/evals/answer-cases.jsonl --models mimo-v2.5 --report data/pathfinder-1e/generated/answer-eval.json",
    "eval:answer:pf:judge": "PYTHONPATH=services/app-python/src:services/retrieval-python/src .venv312/bin/python -m trpg_app.answer_evaluation --config config/app.yaml --documents data/libraries/pathfinder-1e/current/documents.jsonl --index-dir data/libraries/pathfinder-1e/current/vector-index --cases rulepacks/pathfinder-1e/evals/answer-cases.jsonl --models mimo-v2.5 --judge-model mimo-v2.5 --report data/pathfinder-1e/generated/answer-eval-judge.json",
    "eval:long-context:pf": "PYTHONPATH=services/app-python/src .venv312/bin/python -m trpg_app.long_conversation_evaluation --cases rulepacks/pathfinder-1e/evals/long-conversation-cases.jsonl --report data/pathfinder-1e/generated/long-conversation-eval.json",
    "eval:answer:pf:long": "PYTHONPATH=services/app-python/src:services/retrieval-python/src .venv312/bin/python -m trpg_app.answer_evaluation --config config/app.yaml --documents data/libraries/pathfinder-1e/current/documents.jsonl --index-dir data/libraries/pathfinder-1e/current/vector-index --cases rulepacks/pathfinder-1e/evals/long-conversation-cases.jsonl --models mimo-v2.5 --report data/pathfinder-1e/generated/long-conversation-answer-eval.json",
    "eval:answer:pf:evidence-fixed": "PYTHONPATH=services/app-python/src:services/retrieval-python/src .venv312/bin/python -m trpg_app.answer_evaluation --config config/app.yaml --documents data/libraries/pathfinder-1e/current/documents.jsonl --index-dir data/libraries/pathfinder-1e/current/vector-index --cases rulepacks/pathfinder-1e/evals/dynamic-evidence-cases.jsonl --models mimo-v2.5 --report data/pathfinder-1e/generated/evidence-fixed-answer-eval.json",
    "eval:answer:pf:evidence-dynamic": "PYTHONPATH=services/app-python/src:services/retrieval-python/src .venv312/bin/python -m trpg_app.answer_evaluation --config config/app.yaml --documents data/libraries/pathfinder-1e/current/documents.jsonl --index-dir data/libraries/pathfinder-1e/current/vector-index --cases rulepacks/pathfinder-1e/evals/dynamic-evidence-cases.jsonl --models mimo-v2.5 --dynamic-evidence-budget --report data/pathfinder-1e/generated/evidence-dynamic-answer-eval.json",
    "eval:decomposition:pf": "PYTHONPATH=services/app-python/src .venv312/bin/python -m trpg_app.query_decomposition_evaluation --cases rulepacks/pathfinder-1e/evals/query-decomposition-cases.jsonl --report data/pathfinder-1e/generated/query-decomposition-eval.json",
    "eval:complex:pf": "PYTHONPATH=services/app-python/src .venv312/bin/python -m trpg_app.complex_task_evaluation --cases rulepacks/pathfinder-1e/evals/complex-task-cases.jsonl --report data/pathfinder-1e/generated/complex-task-eval.json",
    "eval:complex:pf:retrieval": "PYTHONPATH=services/retrieval-python/src .venv312/bin/python -m trpg_retrieval.evaluation --documents data/libraries/pathfinder-1e/current/documents.jsonl --index-dir data/libraries/pathfinder-1e/current/vector-index --cases rulepacks/pathfinder-1e/evals/complex-task-retrieval-cases.jsonl --report data/pathfinder-1e/generated/complex-task-retrieval-eval.json",
    "eval:complex:pf:stage2": "PYTHONPATH=services/app-python/src:services/retrieval-python/src .venv312/bin/python -m trpg_app.answer_evaluation --config config/app.yaml --documents data/libraries/pathfinder-1e/current/documents.jsonl --index-dir data/libraries/pathfinder-1e/current/vector-index --cases rulepacks/pathfinder-1e/evals/complex-task-answer-cases.jsonl --models mimo-v2.5 --query-decomposition --timeout-seconds 300 --report /private/tmp/complex-task-stage2-answer-eval.json",
    "eval:complex:pf:planner": "PYTHONPATH=services/app-python/src:services/retrieval-python/src .venv312/bin/python -m trpg_app.answer_evaluation --config config/app.yaml --documents data/libraries/pathfinder-1e/current/documents.jsonl --index-dir data/libraries/pathfinder-1e/current/vector-index --cases rulepacks/pathfinder-1e/evals/complex-task-answer-cases.jsonl --models mimo-v2.5 --complex-planner --timeout-seconds 300 --report /private/tmp/complex-task-planner-answer-eval.json",
    "eval:answer:pf:decomposition": "PYTHONPATH=services/app-python/src:services/retrieval-python/src .venv312/bin/python -m trpg_app.answer_evaluation --config config/app.yaml --documents data/libraries/pathfinder-1e/current/documents.jsonl --index-dir data/libraries/pathfinder-1e/current/vector-index --cases rulepacks/pathfinder-1e/evals/query-decomposition-answer-cases.jsonl --models mimo-v2.5 --query-decomposition --timeout-seconds 300 --report data/pathfinder-1e/generated/query-decomposition-answer-eval.json",
    "audit:diversity:pf": "PYTHONPATH=services/retrieval-python/src .venv312/bin/python -m trpg_retrieval.diversity_audit --documents data/libraries/pathfinder-1e/current/documents.jsonl --index-dir data/libraries/pathfinder-1e/current/vector-index --cases rulepacks/pathfinder-1e/evals/retrieval.jsonl --report data/pathfinder-1e/generated/phase0-near-duplicate.json",
    "report:observability:pf": "PYTHONPATH=services/app-python/src .venv312/bin/python -m trpg_app.observability_report --input data/pathfinder-1e/generated/turn-metrics.jsonl --report data/pathfinder-1e/generated/observability-baseline.json",
    "eval:retrieval:gss": "PYTHONPATH=services/retrieval-python/src .venv312/bin/python -m trpg_retrieval.evaluation --documents data/libraries/golden-sky-stories-zh-1-2/current/documents.jsonl --index-dir data/libraries/golden-sky-stories-zh-1-2/current/vector-index --cases rulepacks/golden-sky-stories-zh-1-2/evals/retrieval.jsonl --report data/imports/golden-sky-stories-zh-1-2/retrieval-eval.json",
    "eval:retrieval:gss:vector": "PYTHONPATH=services/retrieval-python/src .venv312/bin/python -m trpg_retrieval.evaluation --documents data/libraries/golden-sky-stories-zh-1-2/current/documents.jsonl --index-dir data/libraries/golden-sky-stories-zh-1-2/current/vector-index --cases rulepacks/golden-sky-stories-zh-1-2/evals/retrieval.jsonl --backend chroma --report data/imports/golden-sky-stories-zh-1-2/retrieval-eval-vector.json",
    "retrieval:dev": "PYTHONPATH=services/retrieval-python/src python3 -m trpg_retrieval.api --documents rulepacks/pathfinder-1e/fixtures/documents.jsonl",
    "retrieval:pf": "PYTHONPATH=services/retrieval-python/src .venv/bin/python -m trpg_retrieval.api --documents data/pathfinder-1e/generated/documents.jsonl --backend hybrid --index-dir data/pathfinder-1e/vector-index-fastembed",
    "retrieval:pf:lexical": "PYTHONPATH=services/retrieval-python/src python3 -m trpg_retrieval.api --documents data/pathfinder-1e/generated/documents.jsonl --backend lexical",
    "cli": "node --env-file=.env --import tsx apps/cli/src/index.ts",
    "gateway": "node --env-file=.env --import tsx apps/gateway/src/index.ts"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  }
}
